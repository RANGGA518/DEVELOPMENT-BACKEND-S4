<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CRUD Produk</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <style>
        .deskripsi {
            max-width: 200px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        img {
            border-radius: 5px;
        }
    </style>

</head>

<body class="container mt-5">

    <h2 class="mb-4">Daftar Produk</h2>

    <a href="/add" class="btn btn-primary mb-3">
        Tambah Produk
    </a>

    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>

                <th>Kode Barang</th>
                <th>Nama Barang</th>
                <th>Deskripsi</th>
                <th>Stok</th>
                <th>Harga</th>
                <th>Kategori</th>
                <th>Gambar</th>
                <th>Aksi</th>

            </tr>
        </thead>

        <tbody>

            <% produk.forEach(function(p){ %>

                <tr>

                    <td>
                        <%= p.kode_barang %>
                    </td>

                    <td>
                        <%= p.nama_barang %>
                    </td>

                    <td class="deskripsi">
                        <%= p.deskripsi %>
                    </td>

                    <td>
                        <%= p.stok %>
                    </td>

                    <td>Rp <%= p.harga %>
                    </td>

                    <td>
                        <span class="badge bg-primary">
                            <%= p.nama_kategori %>
                        </span>
                    </td>

                    <td>

                        <% if(p.gambar){ %>

                            <img src="/images/<%= p.gambar %>" width="80">

                            <% } else { %>

                                Tidak ada gambar

                                <% } %>

                    </td>

                    <td>

                        <a href="/edit/<%= p.kode_barang %>" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a href="/delete/<%= p.kode_barang %>" class="btn btn-danger btn-sm"
                            onclick="return confirm('Yakin ingin menghapus produk?')">
                            Delete
                        </a>

                    </td>

                </tr>

                <% }) %>

        </tbody>

    </table>

</body>

</html>